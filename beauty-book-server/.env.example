JWT_SECRET=beauty-book-dev-secret-key-must-be-at-least-32-bytes-long

# 이메일 인증 (로컬 개발: log-only=true, dev-bypass-code=1234 로 실제 SMTP 없이 테스트 가능)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
AUTH_EMAIL_VERIFICATION_LOG_ONLY=true
AUTH_EMAIL_VERIFICATION_DEV_BYPASS_CODE=1234

AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_S3_REGION=ap-northeast-2
AWS_S3_PREFIX=beauty-book
